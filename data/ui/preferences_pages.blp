using Gtk 4.0;

using Adw 1;

Adw.PreferencesPage configPage {
    title: _("Configurations");
    icon-name: "video-display-symbolic";

    Adw.PreferencesGroup {
        title: _("On-screen Display");
        Adw.ActionRow {
            title: _("Show Profile OSD");
            subtitle: _("Display the profile name after switching monitors.");
            activatable-widget: profileOsdSwitch;
            [suffix]
            Switch profileOsdSwitch {
                valign: center;
            }
        }
    }

    Adw.PreferencesGroup {
        title: _("Saved Configurations");
        description: _("Rename, reorder or remove profiles. Open profile details to see monitor settings and availability.");

        ListBox configListbox {
            selection-mode: none;
            styles ["boxed-list"]
        }
    }

    Adw.PreferencesGroup {
        title: _("Profile Backups");
        description: _("Import adds profiles without replacing existing ones. Identical profiles are skipped. Importing does not switch displays.");

        Adw.ActionRow {
            title: _("Export Profiles");
            subtitle: _("Save all profiles to a JSON file.");
            activatable-widget: exportProfilesButton;
            [suffix]
            Button exportProfilesButton {
                label: _("Export…");
                valign: center;
            }
        }
        Adw.ActionRow {
            title: _("Import Profiles");
            subtitle: _("Restore profiles from a My Vision backup.");
            activatable-widget: importProfilesButton;
            [suffix]
            Button importProfilesButton {
                label: _("Import…");
                valign: center;
            }
        }
    }
}

Adw.PreferencesPage shortcutPage {
    title: _("Shortcuts");
    icon-name: "preferences-desktop-keyboard-shortcuts-symbolic";

    Adw.PreferencesGroup {
        title: _("Shortcuts");
        description: _("Change keyboard shortcuts for switching display configurations.");
        header-suffix: Switch shortcutSwitch {
            valign: center;
        };

        ListBox shortcutListBox {
            selection-mode: none;
            styles ["boxed-list"]
        }
    }
}
